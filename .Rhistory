library(rcompanion)
# Cargar las librerías necesarias
library(MASS)     # Para el conjunto de datos Boston
library(dplyr)    # Para el uso de slice_sample
library(caret)    # Para trainControl y train (Validación Cruzada)
# Fijar una semilla para asegurar la reproducibilidad de la muestra
set.seed(123)
# 1. Obtener la muestra de 250 observaciones del dataset Boston
muestra_boston <- Boston %>%
slice_sample(n = 250)
# 2. Configurar la validación cruzada de 10 pliegues (siguiendo el estilo de tu profesor)
control_pliegues <- trainControl(
method = "cv",
number = 10
)
# 3. Construir y evaluar el modelo de Regresión Lineal Múltiple (RLM)
# Variable de respuesta: rm
# Predictores elegidos: medv (valor de la vivienda) y lstat (estatus socioeconómico bajo)
set.seed(123) # Fijar semilla nuevamente antes de entrenar para mantener consistencia en los pliegues
modelo_rlm_cv <- train(
rm ~ medv + lstat,
data = muestra_boston,
method = "lm",
trControl = control_pliegues
)
# 4. Mostrar los resultados de confiabilidad y calidad predictiva
print(modelo_rlm_cv)
