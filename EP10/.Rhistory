paso3 <- add1(modelo, scope = formula(completo), test = "Chisq") |>
tidy() |>
# CAMBIO CLAVE: Excluimos tanto "Sex" como "Pclass" para que no vuelvan a aparecer
filter(!term %in% c("Sex", "Pclass")) |>
mutate(p.value = format(pvalue(p.value), justify = "right")) |>
arrange(AIC)
cat("", paste("Modelo:", format(formula(modelo))), format(paso3), sep = "\n")
# Agregar la siguiente variable elegida (ejemplo: Pclass) acumulando sobre 'modelo'
modelo <- update(modelo, . ~ . + Age)
# Mostrar los coeficientes del modelo conseguido
cat("\nCoeficientes para los predictores del modelo obtenido:\n")
print(round(modelo[["coefficients"]], 3), width = 56)
residualPlots(modelo, fitted = FALSE)
library(car)
# Graficar únicamente para una variable numérica (Age)
residualPlots(modelo, ~ Age, fitted = FALSE)
# Para las variables de tipo factor, es mejor evaluarlas individualmente
# o inspeccionar su tabla de efectos parciales:
plot(residuals(modelo, type = "pearson") ~ datos_modelo$Pclass,
main = "Residuos para Pclass",
xlab = "Clase de Pasajero",
ylab = "Residuos")
library(car)
# Graficar únicamente para una variable numérica (Age)
residualPlots(modelo, fitted = FALSE)
library(car)
# Graficar únicamente para una variable numérica (Age)
residualPlots(modelo, fitted = FALSE)
ggplot(datos_modelo, aes(x = Sex, y = residuos_dev)) +
geom_boxplot(fill = "lightblue", color = "darkblue") +
geom_jitter(width = 0.2, alpha = 0.4, color = "red") +
labs(title = "Residuos de Deviance vs Sex",
x = "Sexo",
y = "Residuos de Deviance") +
theme_minimal()
library(car)
library(ggplot2)
# Graficar únicamente para una variable numérica (Age)
residualPlots(modelo, fitted = FALSE)
ggplot(datos_modelo, aes(x = Sex, y = residuos_dev)) +
geom_boxplot(fill = "lightblue", color = "darkblue") +
geom_jitter(width = 0.2, alpha = 0.4, color = "red") +
labs(title = "Residuos de Deviance vs Sex",
x = "Sexo",
y = "Residuos de Deviance") +
theme_minimal()
