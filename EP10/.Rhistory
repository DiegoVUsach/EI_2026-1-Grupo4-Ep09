variables_analisis <- datos_entrenamiento |>
select(IMC, Weight, Height, AbdG, WaistG)
View(datos_entrenamiento)
# Selecciona únicamente las columnas que son numéricas o enteras
datos_numericos <- datos_entrenamiento |>
select(where(is.numeric))
# Ahora puedes calcular la matriz de correlación directamente de forma limpia
matriz_correlacion <- cor(datos_numericos, use = "complete.obs")
# Si quieres ver únicamente los valores de correlación con respecto al IMC:
correlaciones_con_imc <- matriz_correlacion["IMC", ]
print(round(correlaciones_con_imc, 2))
# Selecciona únicamente las columnas que son numéricas o enteras
datos_numericos <- datos_entrenamiento |>
select(where(is.numeric))
# Ahora puedes calcular la matriz de correlación directamente de forma limpia
matriz_correlacion <- cor(datos_numericos, use = "complete.obs")
# Si quieres ver únicamente los valores de correlación con respecto al IMC:
correlaciones_con_imc <- matriz_correlacion["IMC", ]
print(round(correlaciones_con_imc, 3))
# Selecciona únicamente las columnas que son numéricas o enteras
datos_numericos <- datos_entrenamiento |>
select(where(is.numeric))
matriz_correlacion <- cor(datos_numericos, use = "complete.obs")
correlaciones_con_imc <- matriz_correlacion["IMC", ]
print(round(correlaciones_con_imc, 3))
# Excluimos la variable IMC de las correlaciones
correlaciones_sin_imc <- correlaciones_con_imc[names(correlaciones_con_imc) != "IMC"]
# Obtenemos el valor máximo de los predictores restantes
max_cor <- max(correlaciones_sin_imc)
cat("El mayor valor de correlación con el IMC es:", round(max_cor, 2), "\n")
# Selecciona únicamente las columnas que son numéricas o enteras
datos_numericos <- datos_entrenamiento |>
select(where(is.numeric))
matriz_correlacion <- cor(datos_numericos, use = "complete.obs")
correlaciones_con_imc <- matriz_correlacion["IMC", ]
